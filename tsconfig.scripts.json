{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.mts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
