{
  "$schema": "../../../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    { "name": "servicenow", "specifier": "../../../.." }
  ],
  "settings": {
    "servicenow": {
      "javascriptMode": "es2021",
      "scopePrefix": "x_acme"
    }
  },
  "rules": {
    "servicenow/no-async-iterators": "error",
    "servicenow/no-weak-references": "error",
    "servicenow/no-unsupported-set-methods": "error",
    "servicenow/no-unsupported-static-methods": "error",
    "servicenow/no-typed-arrays": "error"
  }
}
