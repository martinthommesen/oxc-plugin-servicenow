{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.now/**",
    "**/keys.ts",
    "**/*.min.js"
  ],
  "overrides": [
    {
      "files": ["**/*.now.ts", "**/*.now.tsx"],
      "options": {
        "printWidth": 100,
        "singleQuote": true,
        "trailingComma": "all",
        "semi": true
      }
    },
    {
      "files": [
        "**/*.server.js",
        "**/*.client.js",
        "**/*.br.js",
        "**/*.si.js",
        "**/*.client.ui-action.js",
        "**/*.server.ui-action.js",
        "**/*.ui-action.js",
        "**/src/server/**/*.js",
        "**/src/client/**/*.js",
        "**/{acl,*[-_.]acl}.{js,cjs,mjs}",
        "**/{acl,*[-_.]acl}[-_.]*.{js,cjs,mjs}",
        "**/{access-control,access-controls,*[-_.]access-control,*[-_.]access-controls}.{js,cjs,mjs}",
        "**/{access-control,access-controls,*[-_.]access-control,*[-_.]access-controls}[-_.]*.{js,cjs,mjs}",
        "**/{access_control,access_controls,*[-_.]access_control,*[-_.]access_controls}.{js,cjs,mjs}",
        "**/{access_control,access_controls,*[-_.]access_control,*[-_.]access_controls}[-_.]*.{js,cjs,mjs}",
        "**/{access.control,access.controls,*[-_.]access.control,*[-_.]access.controls}.{js,cjs,mjs}",
        "**/{access.control,access.controls,*[-_.]access.control,*[-_.]access.controls}[-_.]*.{js,cjs,mjs}",
        "**/{accesscontrol,accesscontrols,*[-_.]accesscontrol,*[-_.]accesscontrols}.{js,cjs,mjs}",
        "**/{accesscontrol,accesscontrols,*[-_.]accesscontrol,*[-_.]accesscontrols}[-_.]*.{js,cjs,mjs}",
        "**/{acl,acls,access-control,access-controls,access_control,access_controls,accesscontrol,accesscontrols}/**/*.{js,cjs,mjs}"
      ],
      "options": {
        "printWidth": 120,
        "singleQuote": false,
        "trailingComma": "none",
        "semi": true
      }
    },
    {
      "files": ["**/now.config.json", "**/.oxlintrc.json", "**/.oxfmtrc.json"],
      "options": {
        "printWidth": 80,
        "trailingComma": "none"
      }
    }
  ]
}
