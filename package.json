{
  "name": "oxc-plugin-servicenow",
  "version": "2.0.0",
  "description": "First-class Oxlint + oxfmt tooling for ServiceNow Fluent (.now.ts) and classic ServiceNow JavaScript.",
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "servicenow",
    "fluent",
    "now.ts",
    "eslint-plugin",
    "gliderecord",
    "lint",
    "formatter"
  ],
  "license": "MIT",
  "author": "Martin Lammetun Thommesen",
  "homepage": "https://github.com/martinthommesen/oxc-plugin-servicenow#readme",
  "bugs": {
    "url": "https://github.com/martinthommesen/oxc-plugin-servicenow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinthommesen/oxc-plugin-servicenow.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js",
      "default": "./dist/analysis/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "import": "./dist/oxfmt/index.js",
      "default": "./dist/oxfmt/index.js"
    },
    "./oxfmt.recommended.json": "./oxfmt.recommended.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "oxfmt.recommended.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs && npm run fluent:check",
    "pretest:integration": "npm run build",
    "test:integration": "node scripts/run-tests.mjs tests/integration",
    "test:consumer": "node scripts/run-tests.mjs tests/integration/packed-consumer.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fluent:check": "node --import ./scripts/register-tsx.mjs scripts/check-fluent-manifest.mjs",
    "pretypecheck:fixtures": "npm run build",
    "typecheck:fixtures": "tsc --noEmit -p tsconfig.valid-fixtures.json",
    "lint:check": "oxlint --disable-nested-config --deny-warnings --ignore-pattern 'tests/integration/profiles/**' src scripts tests",
    "format": "oxfmt -c .oxfmtrc.json --write src scripts tests",
    "format:check": "oxfmt -c .oxfmtrc.json --check src scripts tests",
    "docs": "node --import ./scripts/register-tsx.mjs scripts/generate-rule-docs.mjs && node scripts/generate-compatibility-docs.mjs && node --import ./scripts/register-tsx.mjs scripts/generate-australia-engine-docs.mjs",
    "docs:check": "node --import ./scripts/register-tsx.mjs scripts/generate-rule-docs.mjs && node scripts/generate-compatibility-docs.mjs && node --import ./scripts/register-tsx.mjs scripts/generate-australia-engine-docs.mjs && node --import ./scripts/register-tsx.mjs scripts/check-catalog-docs.mjs && git diff --exit-code -- docs/rules README.md docs/compatibility.md docs/australia-engine-updates.md examples tests/integration/profiles/configs/recommended.oxlintrc.json tests/integration/profiles/configs/strict.oxlintrc.json tests/integration/profiles/mixed/.oxlintrc.json tests/integration/fixtures/.oxlintrc.json",
    "compat": "node scripts/compat-consumer.mjs",
    "manifest:check": "node --import ./scripts/register-tsx.mjs scripts/check-fluent-manifest.mjs",
    "manifest:update": "node --import ./scripts/register-tsx.mjs scripts/audit-fluent-sdk.mjs --update",
    "manifest:drift": "node --import ./scripts/register-tsx.mjs scripts/audit-fluent-sdk.mjs --registry",
    "test:fluent": "node scripts/run-tests.mjs tests/fluent-manifest.test.ts tests/rules/fluent-identity.test.ts tests/integration/packed-consumer.test.ts",
    "acceptance:check": "node scripts/verify-acceptance-ledger.mjs",
    "evidence:check": "node --import ./scripts/register-tsx.mjs scripts/verify-doc-evidence.mjs",
    "bench": "node scripts/benchmark.mjs",
    "release:check": "node scripts/check-release-artifact.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "validate": "npm run workflow:check && npm run compat:check && npm run lint:check && npm run format:check && npm run typecheck && npm run typecheck:fixtures && npm test && npm run verify:examples -- --all && npm run test:consumer && npm run evidence:check && npm run acceptance:check && npm run docs:check && npm run manifest:check && npm run bench && npm run release:check -- --consumer",
    "workflow:check": "node scripts/check-action-pins.mjs && node scripts/check-script-paths.mjs",
    "compat:check": "node scripts/check-compat-matrix.mjs"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.79.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <11",
    "oxfmt": ">=0.64.0 <1",
    "oxlint": ">=1.79.0 <2",
    "typescript-eslint": ">=8.0.0 <9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sigstore/core": "3.2.1",
    "@sigstore/mock": "0.12.1",
    "@sigstore/verify": "3.1.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.8.1",
    "oxc-parser": "^0.146.0",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "sigstore": "4.1.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  }
}
