{
  "name": "oxc-plugin-servicenow",
  "version": "2.0.0",
  "description": "First-class Oxlint + oxfmt tooling for ServiceNow Fluent (.now.ts) and classic ServiceNow JavaScript.",
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "servicenow",
    "fluent",
    "now.ts",
    "eslint-plugin",
    "gliderecord",
    "lint",
    "formatter"
  ],
  "license": "MIT",
  "author": "Martin Lammetun Thommesen",
  "homepage": "https://github.com/martinthommesen/oxc-plugin-servicenow#readme",
  "bugs": {
    "url": "https://github.com/martinthommesen/oxc-plugin-servicenow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinthommesen/oxc-plugin-servicenow.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js",
      "default": "./dist/analysis/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "import": "./dist/oxfmt/index.js",
      "default": "./dist/oxfmt/index.js"
    },
    "./oxfmt.recommended.json": "./oxfmt.recommended.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "oxfmt.recommended.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "node scripts/run-tests.mjs && npm run fluent:check",
    "test:integration": "node scripts/run-tests.mjs tests/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fluent:check": "tsx scripts/check-fluent-manifest.mjs",
    "lint:check": "oxlint --disable-nested-config --deny-warnings --ignore-pattern 'tests/integration/profiles/**' src scripts tests",
    "format": "oxfmt -c .oxfmtrc.json --write src scripts tests",
    "format:check": "oxfmt -c .oxfmtrc.json --check src scripts tests",
    "docs": "tsx scripts/generate-rule-docs.mjs",
    "docs:check": "tsx scripts/generate-rule-docs.mjs && git diff --exit-code -- docs/rules README.md examples tests/integration/profiles/configs/recommended.oxlintrc.json tests/integration/profiles/configs/strict.oxlintrc.json tests/integration/profiles/mixed/.oxlintrc.json tests/integration/fixtures/.oxlintrc.json",
    "manifest:check": "tsx scripts/check-fluent-manifest.mjs",
    "manifest:update": "tsx scripts/audit-fluent-sdk.mjs --update",
    "manifest:drift": "tsx scripts/audit-fluent-sdk.mjs --registry",
    "test:fluent": "node scripts/run-tests.mjs tests/fluent-manifest.test.ts tests/rules/fluent-identity.test.ts",
    "validate": "npm run lint:check && npm run format:check && npm run typecheck && npm run build && npm test && npm run docs:check && npm run manifest:check"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.79.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <11",
    "oxfmt": ">=0.64.0 <1",
    "oxlint": ">=1.79.0 <2",
    "typescript-eslint": ">=8.0.0 <9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "oxc-parser": "^0.145.0",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  }
}
